#!/usr/bin/env bash
# Recording stand-in for the GitHub CLI, for the delivery and issue-fix
# cases: the eval sandbox has no network and no account, so every call is
# appended to gh-calls.log next to this script and answered with the shape
# the real command prints. The graders read the log; nothing here reaches
# GitHub. Three files beside this script, each written by a loop state,
# change what it answers:
#   pr-open       the slice branch has an open pull request (#7)
#   ci-red        a commit hash: while the remote's slice branch is at that
#                 commit the pull request's check fails (and `pr checks`
#                 exits 1, as the real command does); a later push is green
#   ci-failed.log what `run view --log-failed` prints
#   issues.json   what `issue list` prints
#   ci-check      the name of the failing check when it is not `checks`
#                 (`screens`); `checks` is then listed as passing beside it
#   ci-artifact/  what `run download` puts in its `--dir` while the check
#                 is red: the failing run's uploaded artifact
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
log="$here/gh-calls.log"
printf '%s\n' "$*" >> "$log"
repo="example/library-lending"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
pushed="$(git rev-parse -q --verify "refs/remotes/origin/$branch" 2>/dev/null || true)"
red=""
if [ -f "$here/ci-red" ] && [ -n "$pushed" ] && [ "$pushed" = "$(cat "$here/ci-red")" ]; then red=yes; fi
case "${1:-} ${2:-}" in
  "repo view") echo "{\"defaultBranchRef\":{\"name\":\"main\"},\"nameWithOwner\":\"$repo\"}" ;;
  "pr list")
    if [ -f "$here/pr-open" ]; then
      echo "[{\"number\":7,\"headRefName\":\"$branch\",\"url\":\"https://github.com/$repo/pull/7\",\"title\":\"Staff cancel a member's hold on a title\",\"state\":\"OPEN\"}]"
    else
      echo "[]"
    fi ;;
  "pr create") echo "https://github.com/$repo/pull/7" ;;
  "pr edit") echo "https://github.com/$repo/pull/7" ;;
  "pr view") echo "{\"number\":7,\"url\":\"https://github.com/$repo/pull/7\",\"state\":\"OPEN\",\"headRefName\":\"$branch\",\"baseRefName\":\"main\",\"headRefOid\":\"$pushed\"}" ;;
  "pr checks")
    failing=checks
    [ ! -f "$here/ci-check" ] || failing="$(cat "$here/ci-check")"
    if [ -n "$red" ]; then
      [ "$failing" = checks ] || printf '✓\tchecks\t1m52s\thttps://github.com/%s/actions/runs/9100/job/50170\n' "$repo"
      printf 'X\t%s\t2m14s\thttps://github.com/%s/actions/runs/9101/job/50177\n' "$failing" "$repo"
      exit 1
    fi
    printf '✓\tchecks\t1m52s\thttps://github.com/%s/actions/runs/9102/job/50190\n' "$repo"
    [ "$failing" = checks ] || printf '✓\t%s\t1m41s\thttps://github.com/%s/actions/runs/9103/job/50191\n' "$failing" "$repo" ;;
  "run download")
    dir=.
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir|-D) dir="${2:-.}"; shift ;;
        --dir=*) dir="${1#--dir=}" ;;
      esac
      shift
    done
    if [ -n "$red" ] && [ -d "$here/ci-artifact" ]; then
      mkdir -p "$dir"
      cp -R "$here/ci-artifact/." "$dir/"
    else
      echo "no valid artifacts found to download" >&2
      exit 1
    fi ;;
  "run view")
    # The failing log while the check is red; where no state says which
    # commit is red (no ci-red file), the log whenever one is there.
    if [ -f "$here/ci-failed.log" ] && { [ -n "$red" ] || [ ! -f "$here/ci-red" ]; }; then cat "$here/ci-failed.log"; else echo "run ${3:-9102}: completed, success"; fi ;;
  "run list")
    if [ -n "$red" ]; then
      echo "[{\"databaseId\":9101,\"conclusion\":\"failure\",\"status\":\"completed\",\"headSha\":\"$pushed\",\"workflowName\":\"$([ -f "$here/ci-check" ] && cat "$here/ci-check" || echo ci)\"}]"
    elif [ -f "$here/ci-check" ]; then
      echo "[{\"databaseId\":9102,\"conclusion\":\"success\",\"status\":\"completed\",\"headSha\":\"$pushed\",\"workflowName\":\"ci\"},{\"databaseId\":9103,\"conclusion\":\"success\",\"status\":\"completed\",\"headSha\":\"$pushed\",\"workflowName\":\"$(cat "$here/ci-check")\"}]"
    else
      echo "[{\"databaseId\":9102,\"conclusion\":\"success\",\"status\":\"completed\",\"headSha\":\"$pushed\",\"workflowName\":\"ci\"}]"
    fi ;;
  "issue create") n=$((40 + $(grep -c '^issue create' "$log"))); echo "https://github.com/$repo/issues/$n" ;;
  "issue list") if [ -f "$here/issues.json" ]; then cat "$here/issues.json"; else echo "[]"; fi ;;
  "issue comment") echo "https://github.com/$repo/issues/14#issuecomment-1" ;;
  "label create") echo "✓ Label \"tech-debt\" created in $repo" ;;
  "label list") echo "tech-debt" ;;
  "auth status") echo "Logged in to github.com account example" ;;
  "api "*|"api")
    # A tag lookup (`repos/<owner>/<action>/git/ref/tags/<tag>`) answers
    # with a commit made up from the path, the same one every time, so a
    # workflow written from it carries a full 40-character pin.
    case "${2:-}" in
      *git/ref/tags/*|*git/refs/tags/*)
        sha="$(printf '%s' "$2" | git hash-object --stdin)"
        echo "{\"ref\":\"refs/tags/${2##*/}\",\"object\":{\"type\":\"commit\",\"sha\":\"$sha\"}}" ;;
      *) echo "[]" ;;
    esac ;;
  *) echo "gh (stand-in): unsupported command: $*" >&2; exit 1 ;;
esac
